# =====================================================
# ASMR Block 공개용 설정 (.env.public)  ⚠ 이 파일은 GitHub에 올리지 않아요 (.gitignore)
# start-public.bat 이 처음 실행될 때 이 내용으로 .env.public 을 만들고 비밀값을 랜덤으로 채워요
# 아래 세 곳(값이 CHANGE_ME 인 줄)만 내 값으로 바꾸고 저장하면 돼요
# =====================================================

# 사이트 주소 (https로, 끝에 / 없이)
PUBLIC_URL=https://asmrblock.com

# Cloudflare 터널 토큰 (Zero Trust > Networks > Tunnels > 터널 만들기 > Docker 탭의 긴 글자)
TUNNEL_TOKEN=CHANGE_ME

# 관리자 계정: 이 이메일·비밀번호로 관리자 페이지(/admin)에 들어가요. 비밀번호는 10자 이상, 나만 아는 것으로
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# 로그인 토큰 비밀키·DB 비밀번호 (자동으로 랜덤, 바꾸지 않아도 돼요)
JWT_SECRET=
DB_PASSWORD=

# 베타 기간 "베타로 바로 시작" 버튼 (정식 출시 때 false)
BETA_QUICK_LOGIN=true

# 파일 저장소 (비워 두면 이 PC). Cloudflare R2로 옮길 때만 아래 # 를 지우고 채우기 → docs/r2_guide.md
# STORAGE_TYPE=s3
# R2_ENDPOINT=https://계정ID.r2.cloudflarestorage.com
# R2_BUCKET=asmrblock-files
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_URL=https://files.asmrblock.com
